NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to client.
SUPABASE_SECRET_KEY=

# Push notifications (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

CALENDAR_TOKEN_ENC_KEY=

GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
NEXT_PUBLIC_APP_URL=http://localhost:3000

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile site key (secret key lives in Supabase dashboard)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 'preview' or 'stable'
NEXT_PUBLIC_RELEASE_CHANNEL=preview

# Content Security Policy: unset (enforces) or 'report-only'
CSP_MODE=

NEXT_PUBLIC_SENTRY_DSN=
# Sentry source map upload (CI only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=